# Copy to ~/.config/growhelper/dashboard.env and chmod 600.
# For the default SSH-tunnel deployment these credentials are optional because
# the Dashboard binds to 127.0.0.1. They become mandatory when binding to a
# non-loopback address.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48
