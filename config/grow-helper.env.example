# Copy the relevant values to ~/.hermes/profiles/grow-helper/.env
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Closed pilot: comma-separated Telegram numeric user IDs.
# Recommended deployment: use this allowlist or Hermes DM pairing.
# Do not set GATEWAY_ALLOW_ALL_USERS=true for this local-tool agent.
TELEGRAM_ALLOWED_USERS=123456789
# Consumed by install-team.py to enable Hermes' admin/user slash-command split.
GROWHELPER_TELEGRAM_ADMIN_USERS=123456789
# install-team.py copies this list into
# gateway.platforms.telegram.extra.allow_admin_from. Every other allowed/paired
# user remains a regular user and gets only /help and /whoami unless you
# explicitly add user_allowed_commands in config.yaml.
GROWHELPER_DATA_ROOT=/home/growhelper/grow-helper
GROWHELPER_TIMEZONE=Asia/Dushanbe
GROWHELPER_MAX_MEDIA_BYTES=52428800
GROWHELPER_TELEGRAM_TIMEOUT_SECONDS=20
